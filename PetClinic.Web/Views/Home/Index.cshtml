@{
    ViewData["Title"] = "Panel de Inicio";
}

<!-- Welcome Dashboard -->
<div class="px-8 py-10 border-b border-outline-variant bg-surface-container-low shadow-sm">
    <div class="max-w-4xl">
        <h1 class="text-4xl font-light text-on-surface mb-2">Bienvenido, <span class="font-bold text-primary">@User.Identity?.Name</span></h1>
        <p class="text-secondary text-base">Sistema centralizado de alto rendimiento para el control de la clínica veterinaria **VetCorp**.</p>
    </div>
</div>

<div class="p-8 space-y-8">
    <!-- Quick Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white p-6 border border-outline-variant rounded-xl shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-12 h-12 bg-primary-container/30 text-primary flex items-center justify-center rounded-full">
                <span class="material-symbols-outlined text-2xl font-bold">calendar_month</span>
            </div>
            <div>
                <span class="text-xs font-semibold text-secondary uppercase block">Citas Activas</span>
                <span class="text-2xl font-bold text-on-surface">@DateTime.UtcNow.ToString("dd MMM")</span>
            </div>
        </div>
        <div class="bg-white p-6 border border-outline-variant rounded-xl shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-12 h-12 bg-tertiary-container/30 text-tertiary flex items-center justify-center rounded-full">
                <span class="material-symbols-outlined text-2xl font-bold">pets</span>
            </div>
            <div>
                <span class="text-xs font-semibold text-secondary uppercase block">Pacientes Activos</span>
                <span class="text-2xl font-bold text-on-surface">4 Registrados</span>
            </div>
        </div>
        <div class="bg-white p-6 border border-outline-variant rounded-xl shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-12 h-12 bg-secondary-container/50 text-secondary flex items-center justify-center rounded-full">
                <span class="material-symbols-outlined text-2xl font-bold">group</span>
            </div>
            <div>
                <span class="text-xs font-semibold text-secondary uppercase block">Veterinarios</span>
                <span class="text-2xl font-bold text-on-surface">3 Médicos</span>
            </div>
        </div>
        <div class="bg-white p-6 border border-outline-variant rounded-xl shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-12 h-12 bg-error-container/30 text-error flex items-center justify-center rounded-full">
                <span class="material-symbols-outlined text-2xl font-bold">shield</span>
            </div>
            <div>
                <span class="text-xs font-semibold text-secondary uppercase block">Perfil</span>
                <span class="text-2xl font-bold text-on-surface">Administrador</span>
            </div>
        </div>
    </div>

    <!-- Main Navigation Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Appointments Panel -->
        <div class="bg-white border border-outline-variant rounded-xl shadow-sm overflow-hidden flex flex-col hover:shadow-md transition-shadow">
            <div class="p-6 border-b border-outline-variant bg-surface-container-low flex justify-between items-center">
                <h3 class="font-bold text-lg text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">event_upcoming</span>
                    <span>Agenda de Citas</span>
                </h3>
                <span class="text-xs text-secondary font-semibold">Año 2026</span>
            </div>
            <div class="p-8 flex-1 flex flex-col justify-between space-y-6">
                <p class="text-sm text-secondary leading-relaxed">
                    Administre la agenda completa del equipo veterinario. Programe nuevas consultas, asigne médicos a mascotas y evite conflictos de horarios automáticamente.
                </p>
                <div class="flex gap-4">
                    <a class="px-5 py-3 bg-primary text-on-primary text-sm font-semibold rounded-lg hover:brightness-110 hover:shadow-md transition-all text-center flex-1" asp-controller="Appointments" asp-action="Index">Ver Agenda</a>
                </div>
            </div>
        </div>

        <!-- Management Info Panel -->
        <div class="bg-white border border-outline-variant rounded-xl shadow-sm overflow-hidden flex flex-col hover:shadow-md transition-shadow">
            <div class="p-6 border-b border-outline-variant bg-surface-container-low flex justify-between items-center">
                <h3 class="font-bold text-lg text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-tertiary">health_and_safety</span>
                    <span>Control de Acceso Seguro</span>
                </h3>
                <span class="text-xs text-secondary font-semibold">Sistema Cerrado</span>
            </div>
            <div class="p-8 flex-1 flex flex-col justify-between space-y-6">
                <p class="text-sm text-secondary leading-relaxed">
                    El sistema opera bajo una barrera estricta de inicio de sesión único. Solo el perfil del Administrador está habilitado para gestionar e ingresar registros de mascotas, propietarios y médicos.
                </p>
                <div class="p-4 bg-tertiary-container/30 border-l-4 border-tertiary rounded-lg text-xs text-on-tertiary-fixed-variant flex items-center gap-2">
                    <span class="material-symbols-outlined">verified_user</span>
                    <span>Entorno de datos relacionales protegido y auditado pasivamente (Shadow Properties).</span>
                </div>
            </div>
        </div>
    </div>
</div>
