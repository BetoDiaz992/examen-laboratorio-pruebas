<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetClinic</title>
    
    <!-- Tipografía Moderna desde Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #0B2545;      /* Navy Blue Profundo */
            --secondary: #134074;    /* Steel Blue */
            --accent: #8DA9C4;       /* Light Blue */
            --bg-light: #EEF4F8;     /* Off-White */
            --text-dark: #1D2A3A;    /* Gris Oscuro */
            --text-light: #FFFFFF;
            --shadow: 0 4px 20px rgba(11, 37, 69, 0.08);
        }

        body {
            margin: 0;
            font-family: 'Outfit', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-light);
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Menú superior tipo Cinta (Ribbon Menu) */
        .ribbon-nav {
            background-color: var(--primary);
            box-shadow: var(--shadow);
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 70px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .ribbon-brand {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-light);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .ribbon-menu {
            display: flex;
            list-style: none;
            margin: 0;
            padding: 0;
            height: 100%;
        }

        .ribbon-item {
            height: 100%;
        }

        .ribbon-link {
            display: flex;
            align-items: center;
            padding: 0 24px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            height: 100%;
            transition: all 0.25s ease;
            position: relative;
        }

        .ribbon-link:hover, .ribbon-item.active .ribbon-link {
            color: var(--text-light);
            background-color: var(--secondary);
        }

        /* Línea indicadora debajo de pestaña activa */
        .ribbon-item.active .ribbon-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background-color: var(--accent);
        }

        .ribbon-user {
            color: var(--text-light);
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .btn-logout {
            background-color: transparent;
            border: 1.5px solid var(--accent);
            color: var(--accent);
            padding: 6px 16px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            transition: all 0.25s ease;
        }

        .btn-logout:hover {
            background-color: var(--accent);
            color: var(--primary);
        }

        /* Contenedor Principal */
        .container {
            flex: 1;
            max-width: 1200px;
            width: 100%;
            margin: 30px auto;
            padding: 0 20px;
            box-sizing: border-box;
        }

        /* Footer */
        footer {
            background-color: var(--primary);
            color: var(--accent);
            text-align: center;
            padding: 20px 0;
            font-size: 13px;
            margin-top: auto;
            box-shadow: 0 -4px 20px rgba(0,0,0,0.05);
        }
    </style>
</head>
<body>

    @* Regla Estricta: La cinta de navegación solo es visible para administradores autenticados *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="ribbon-nav">
            <a href="/" class="ribbon-brand">
                🐾 <span>PetClinic Admin</span>
            </a>
            
            <ul class="ribbon-menu">
                <li class="ribbon-item @(ViewData["ActiveTab"]?.ToString() == "Inicio" ? "active" : "")">
                    <a href="/Home" class="ribbon-link">Inicio</a>
                </li>
                <li class="ribbon-item @(ViewData["ActiveTab"]?.ToString() == "Propietarios" ? "active" : "")">
                    <a href="/Owners" class="ribbon-link">Propietarios</a>
                </li>
                <li class="ribbon-item @(ViewData["ActiveTab"]?.ToString() == "Mascotas" ? "active" : "")">
                    <a href="/Pets" class="ribbon-link">Mascotas</a>
                </li>
                <li class="ribbon-item @(ViewData["ActiveTab"]?.ToString() == "Citas" ? "active" : "")">
                    <a href="/Appointments" class="ribbon-link">Citas</a>
                </li>
            </ul>

            <div class="ribbon-user">
                <span>Bienvenido, <strong>@User.Identity.Name</strong></span>
                <form action="/Account/Logout" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout">Salir</button>
                </form>
            </div>
        </nav>
    }

    <main class="container">
        @RenderBody()
    </main>

    <footer>
        <p>&copy; @DateTime.Now.Year - PetClinic Software Suite. Todos los derechos reservados bajo Estándares Clean Architecture.</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
